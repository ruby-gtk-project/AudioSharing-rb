{
    "app-id": "de.haeckerfelix.AudioSharing.Devel",
    "runtime": "org.gnome.Platform",
    "runtime-version": "master",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions" : [
        "org.freedesktop.Sdk.Extension.rust-stable",
        "org.freedesktop.Sdk.Extension.llvm14"
    ],
    "command": "audio-sharing",
    "tags" : [
        "nightly"
    ],
    "finish-args" : [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--socket=pulseaudio",
        "--env=RUST_LOG=audio_sharing=debug",
        "--env=RUST_BACKTRACE=1"
    ],
    "build-options" : {
        "append-path" : "/usr/lib/sdk/rust-stable/bin:/usr/lib/sdk/llvm14/bin",
        "env": {
            "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER": "clang",
            "CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_RUSTFLAGS": "-C link-arg=-fuse-ld=/usr/lib/sdk/rust-stable/bin/mold"
        },
        "build-args" : [
            "--share=network"
        ]
    },
    "modules": [
        {
            "name": "gst-rtsp-server",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.freedesktop.org/gstreamer/gst-rtsp-server.git",
                    "tag": "1.16.2"
                }
            ]
        },
        {
            "name": "audio-sharing",
            "buildsystem": "meson",
            "run-tests": true,
            "config-opts": ["-Dprofile=development"],
            "sources": [
                {
                    "type": "git",
                    "url": "https://gitlab.gnome.org/World/AudioSharing.git",
                    "branch": "main"
                }
            ]
        }
    ]
}
