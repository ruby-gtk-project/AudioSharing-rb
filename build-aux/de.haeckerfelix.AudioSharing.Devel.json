{
    "app-id": "de.haeckerfelix.AudioSharing.Devel",
    "runtime": "org.gnome.Platform",
    "runtime-version": "master",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
    "command": "audio-sharing",
    "finish-args" : [
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--share=network",
        "--talk-name=org.a11y.Bus",
        "--env=RUST_LOG=audio_sharing=debug",
        "--env=RUST_BACKTRACE=1",
        "--socket=pulseaudio"
    ],
    "build-options" : {
        "append-path" : "/usr/lib/sdk/rust-stable/bin",
        "build-args" : [
            "--share=network"
        ]
    },
    "modules": [
	{
	    "name": "gst-rtsp-server",
	    "buildsystem": "meson",
	    "config-opts": [
		"-Ddoc=disabled"
	    ],
	    "sources": [
		{
		    "type": "git",
		    "url": "https://gitlab.freedesktop.org/gstreamer/gst-rtsp-server.git",
		    "tag": "1.16.2"
		}
	    ]
	},
        {
            "name" : "libadwaita",
            "buildsystem" : "meson",
            "config-opts" : [
                "-Dintrospection=enabled",
                "-Dtests=false",
                "-Dexamples=false",
                "-Dvapi=false"
            ],
            "cleanup" : [
                "/include",
                "/lib/pkgconfig"
            ],
            "sources" : [
                {
                    "type" : "git",
                    "url" : "https://gitlab.gnome.org/GNOME/libadwaita.git",
                    "tag" : "1.0.0-alpha.2"
                }
            ]
        },
        {
            "name": "audio-sharing",
            "buildsystem": "meson",
            "run-tests": true,
            "config-opts": ["-Dprofile=development"],
            "sources": [
                {
                    "type": "git",
                    "path": "https://gitlab.gnome.org/World/AudioSharing.git"
                }
            ]
        }
    ]
}
