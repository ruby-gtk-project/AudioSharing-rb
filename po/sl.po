msgid "translator-credits"
msgstr "Matej Urbančič <mateju@src.gnome.org>"

#: src/ui/window.rs:82
msgid "Copied address to clipboard"
msgstr "Kopiraj naslov v odložišče"

#: src/app.rs:138
msgid "A client has established a connection"
msgstr "Program je vzpostavil povezavo"

#: src/app.rs:139
msgid "Audio playback from this device gets shared."
msgstr "Zvočni posketek bo oddajan s te naprave."
