msgstr "Hemish <hemish04082005@gmail.com>"

#: src/ui/window.rs:83
msgid "Copied address to clipboard"
msgstr "पता क्लिपबोर्ड पर कॉपी कर दिया गया"

#: src/app.rs:144
msgid "A client has established a connection"
msgstr "एक क्लाइंट ने एक कनेक्शन स्थापित किया है"

#: src/app.rs:145
msgid "Audio playback from this device gets shared."
msgstr "इस डिवाइस से ऑडियो प्लेबैक शेयर किया जाएगा।"

