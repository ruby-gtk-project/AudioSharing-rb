msgid "translator-credits"
msgstr "Ingirafn Steinarsson, ingirafn at this dot is, 2023"

#: src/ui/window.rs:83
msgid "Copied address to clipboard"
msgstr "Afritaði veffang á klippispjald"

#: src/app.rs:144
msgid "A client has established a connection"
msgstr "Notandi hefur komið á tengingu"

#: src/app.rs:145
msgid "Audio playback from this device gets shared."
msgstr "Afspilun hljóðs frá þessu tæki deilist."
